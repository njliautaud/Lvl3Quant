    },
    "v8_comparison_chain_only": {
      "v8_sharpe": 3.17,
      "v9_sharpe": 3.50,
      "improvement_pct": 10.4,
      "v8_final": 23067,
      "v9_final": 36620,
      "improvement_final_pct": 58.8
    },
    "structural_edge": {
      "random_mean_sharpe": 2.06,
